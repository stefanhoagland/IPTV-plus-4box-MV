<?xml version="1.0"?>
<Container version="2">
  <Name>iptv-multiview</Name>
  <Repository>ghcr.io/stefanhoagland/iptv-plus-4box-mv:latest</Repository>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Self-hosted IPTV manager with a 4-box multiview: click any box to choose the channel it plays.</Overview>
  <Category>MediaServer:Video</Category>
  <WebUI>http://[IP]:[PORT:9292]/</WebUI>
  <Icon>https://raw.githubusercontent.com/stefanhoagland/iptv-plus-4box-mv/main/web/public/icon.svg</Icon>
  <Config Name="WebUI Port" Target="9292" Default="9292" Mode="tcp" Description="Port for the web interface" Type="Port" Display="always" Required="true" Mask="false">9292</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/iptv-multiview" Mode="rw" Description="Database and settings" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/iptv-multiview</Config>
  <Config Name="Admin username" Target="ADMIN_USERNAME" Default="" Mode="" Description="Optional: create/reset the admin login on startup" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Admin password" Target="ADMIN_PASSWORD" Default="" Mode="" Description="Optional: password for the admin login above (8+ characters)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Secure cookies" Target="SECURE_COOKIES" Default="false" Mode="" Description="Set to true when served over HTTPS via a reverse proxy" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
</Container>
